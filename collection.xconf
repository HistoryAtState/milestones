<?xml version="1.0" encoding="UTF-8"?>
<collection xmlns="http://exist-db.org/collection-config/1.0">
    <index xmlns:tei="http://www.tei-c.org/ns/1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
        <lucene vector-store="db">
            <analyzer class="org.apache.lucene.analysis.standard.StandardAnalyzer"/>
            <!-- Analyzer chains (eXist 7 lucene analyzer chains) for hsg-jinks's search
                 options. plain is the default field's: words are runs of non-space
                 characters without the punctuation around them, split at em dashes
                 (a pattern tokenizer, so highlights cover the word only); possessives
                 dropped; each word indexed whole and in its parts (U.S.-Soviet:
                 u.s.-soviet, u.s, soviet) but the parts never
                 joined, so U.S. is not "us"; at query time a word is kept whole;
                 lower-cased and folded (so F-16 equals F–16). cased keeps case; stemmed
                 adds English (Porter) stemming; punct and literal keep words as written
                 (no parts; literal keeps case too). -->
            <analyzer id="plain">
                <index>
                    <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                    <filter name="length" min="1" max="255"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" splitOnNumerics="0"/>
                    <filter name="flattenGraph"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                </index>
                <query>
                    <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                    <filter name="length" min="1" max="255"/>
                    <filter name="englishPossessive"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                </query>
            </analyzer>
            <analyzer id="cased">
                <index>
                    <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                    <filter name="length" min="1" max="255"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" splitOnNumerics="0"/>
                    <filter name="flattenGraph"/>
                    <filter name="asciiFolding"/>
                </index>
                <query>
                    <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                    <filter name="length" min="1" max="255"/>
                    <filter name="englishPossessive"/>
                    <filter name="asciiFolding"/>
                </query>
            </analyzer>
            <analyzer id="punct">
                <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                <filter name="length" min="1" max="255"/>
                <filter name="lowercase"/>
                <filter name="asciiFolding"/>
            </analyzer>
            <analyzer id="literal">
                <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                <filter name="length" min="1" max="255"/>
                <filter name="asciiFolding"/>
            </analyzer>
            <analyzer id="stemmed">
                <index>
                    <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                    <filter name="length" min="1" max="255"/>
                    <filter name="englishPossessive"/>
                    <filter name="wordDelimiterGraph" preserveOriginal="1" splitOnNumerics="0"/>
                    <filter name="flattenGraph"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                    <filter name="porterStem"/>
                </index>
                <query>
                    <tokenizer name="pattern" pattern="[^\s\p{P}](?:[^\s—―]*[^\s\p{P}])?" group="0"/>
                    <filter name="length" min="1" max="255"/>
                    <filter name="englishPossessive"/>
                    <filter name="lowercase"/>
                    <filter name="asciiFolding"/>
                    <filter name="porterStem"/>
                </query>
            </analyzer>
            <text qname="tei:div" index="no">
                <!-- start required facets and fields -->
                <facet dimension="hsg-category" expression="'retired'"/>
                <facet dimension="hsg-publication" expression="'milestones'"/>
                <field analyzer="plain" name="hsg-fulltext" if="@type eq 'section'" store="no"/>
                <field analyzer="stemmed" name="hsg-fulltext-stemmed" if="@type eq 'section'" store="no"/>
                <field analyzer="cased" name="hsg-fulltext-cased" if="@type eq 'section'" store="no"/>
                <field analyzer="punct" name="hsg-fulltext-punct" if="@type eq 'section'" store="no"/>
                <field analyzer="literal" name="hsg-fulltext-literal" if="@type eq 'section'" store="no"/>
                <vector-field name="hsg-passages" dimension="384" similarity="cosine" embedding="local" model="all-MiniLM-L6-v2"
                    chunk="tokens" chunk-overlap="16"
                    chunk-units="if (@type eq 'section') then node() else ()"
                    chunk-context="normalize-space((.//tei:head)[1])"
                    quantize="int8"/>
                <vector-field name="hsg-embedding" expression="if (@type eq 'section') then . else ()"
                    dimension="384" similarity="cosine"
                    embedding="local" model="all-MiniLM-L6-v2"/>
                <field name="hsg-url" expression="'/milestones/' || substring-before(util:document-name(.), '.xml') || (if (./ancestor::tei:front) then () else ('/' || @xml:id))"/>
                <!-- end required facets and fields -->
            </text>
        </lucene>
        <create qname="@target" type="xs:string"/>
        <create qname="@corresp" type="xs:string"/>
        <create qname="@type" type="xs:string"/>
        <create qname="@xml:id" type="xs:string"/>
        <create qname="@id" type="xs:string"/>
        <create qname="@rend" type="xs:string"/>
        <create qname="@n" type="xs:string"/>
        <create qname="tei:idno" type="xs:string"/>
    </index>
</collection>
